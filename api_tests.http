  "name": "Updated User One",
  "avatar": "https://picsum.photos/seed/updated/200"
}

### 15. Update Profile without Token (Should Fail - Edge Case)
PUT {{baseUrl}}/auth/update-profile
Content-Type: application/json

{
  "name": "Hacker Update"
}

### 16. Update Profile with Empty Data (Edge Case)
PUT {{baseUrl}}/auth/update-profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "",
  "avatar": ""
}

